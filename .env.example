# Copy to .env and fill in ONLY if you want optional LLM phrasing of results.
# The entire core system (ML, SHAP, counterfactuals, risk, stress, RAG retrieval)
# runs fully offline WITHOUT any of these.

# Which provider the LLM layer uses when enabled (see llm.provider in config.yaml):
#   anthropic | openai | gemini | ollama
# Set the key matching your provider. Ollama needs no key (runs locally).

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Optional: override the Ollama endpoint if you use a local model.
# OLLAMA_BASE_URL=http://localhost:11434
