# Secrets (never commit real keys; .env.example holds placeholders only)
.env
.env.*
!.env.example
*.pem
*.key
secrets.*

# Data: only the zipped Home Credit file is committed (GitHub 100 MB limit);
# the raw CSV and processed splits are regenerated locally
data/raw/*
!data/raw/.gitkeep
!data/raw/application_train.csv.zip
data/processed/*
!data/processed/.gitkeep

# Model artifacts and vector store (regenerated by training / ingestion)
artifacts/*
!artifacts/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# OS / editor
.DS_Store
.vscode/
.idea/

# Local tooling
.claude/
*.log
